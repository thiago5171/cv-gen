{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Background Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "basicInfo", "experience", "education", "skills"],
  "properties": {
    "name": { "type": "string" },
    "basicInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "location", "email", "phone", "links"],
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": { "type": "string" },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "company",
          "location",
          "startDate",
          "endDate",
          "bullets",
          "skills"
        ],
        "properties": {
          "role": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "summary": { "type": "string" },
          "bullets": {
            "description": "Achievements and responsibilities with metrics where available.",
            "type": "array",
            "items": { "type": "string" }
          },
          "skills": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "school", "location", "startDate", "endDate"],
        "properties": {
          "degree": { "type": "string" },
          "school": { "type": "string" },
          "location": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "issuer", "year"],
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "year": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string" }
        }
      }
    },
    "skills": { "type": "array", "items": { "type": "string" } }
  }
}
